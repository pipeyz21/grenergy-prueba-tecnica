API_KEY=change-me
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://your-frontend.pages.dev

FABRIC_SQL_ENDPOINT=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=your_lakehouse_name

# Solo para DATA_SOURCE=fabric en un servidor (service principal). En local déjarlos vacíos.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=


# De dónde salen los precios:
#   fabric   - consulta el lakehouse en vivo. Requiere credenciales de Entra (az login en local,
#              o los AZURE_* de arriba en un servidor). Es la única opción con datos al día.
#   local    - sirve los CSV que descargues del lakehouse a backend/.data/. Sin credenciales:
#              es lo que permite trabajar y desplegar sin secretos. Datos reales, congelados
#              en el momento de la descarga.
#   demo     - datos sintéticos. Solo para desarrollar la interfaz. NO son precios reales.
DATA_SOURCE=fabric
